# Copy to checker/.env (gitignored) and fill in what you have. Everything is optional.

# Google sign-in + Gmail inbox scan (README: "Google setup")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Send verification codes by email (resend.com). Without it, codes print in the server console.
RESEND_API_KEY=
EMAIL_FROM=BreachLink <onboarding@resend.dev>

# Tiger Data connection string for the breach timeline
DATABASE_URL=

# Where to send people back after Google sign-in. The BreachLink frontend (serve.ps1) runs on port 8000.
# Use http://localhost:8787/dev to test sign-in without the frontend.
FRONTEND_URL=http://localhost:8000

# Deployed only (see deploy/DEPLOY.md): the public address. Turns on Secure cookies, uses it for the Google redirect
# and as the default FRONTEND_URL, and turns /dev off (DEV_PAGE=1 turns it back on).
PUBLIC_URL=
DEV_PAGE=
# Optional. Defaults to localhost for local development, 0.0.0.0 when PUBLIC_URL is set.
HOST=
