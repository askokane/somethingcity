# Copy to checker/.env (gitignored) and fill in what you have. Everything is optional.

# Google sign-in + Gmail inbox scan (README: "Google setup")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Send verification codes by email (resend.com). Without it, codes print in the server console.
RESEND_API_KEY=
EMAIL_FROM=Breach City <onboarding@resend.dev>

# Gemini explanations for breaches (aistudio.google.com -> Get API key). Only breach metadata is sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tiger Data connection string for the breach timeline
DATABASE_URL=

# Where to send people back after Google sign-in. Use http://localhost:8787/dev to test without the frontend.
FRONTEND_URL=http://localhost:5173
